// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  message   String
  createdAt DateTime @default(now())
}
